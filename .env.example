# 1. DeepSeek：知识问答、占卜解读和文本案例整理
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=90
CASE_EXTRACT_MODEL=deepseek-v4-pro

# 2. 硅基流动 embedding API：仅使用外部向量服务
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_BATCH_SIZE=16

# 3. 知识检索：使用独立 API 索引，先运行 rebuild_api_index.py
RETRIEVAL_MODE=vector
VECTOR_STORE_BACKEND=numpy
LOCAL_INDEX_DIR=data/indexes/api_vectors
BUILD_CHROMA=0

# 4. 可选截图识别：只在本地提取截图案例时使用
# 不使用时 VISION_API_KEY 留空；使用时可填写同一 DeepSeek 账号的密钥。
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash

# 5. 本地 PDF/OCR：已有知识片段重建索引不需要 OCR
# 重新处理扫描 PDF 时，在完整本地环境中将 PDF_OCR_ENABLED 改为 1。
PDF_OCR_ENABLED=0
PDF_OCR_DPI=180
PDF_OCR_MIN_CHARS=40

# 6. 后端访问：本地测试可留空，Modal 上线在 Secrets 中设置随机令牌
API_ACCESS_TOKEN=
API_REQUESTS_PER_MINUTE=10
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
PUBLIC_API_DOCS=1

# 7. 本地模型回退配置：仅 EMBEDDING_PROVIDER=local 时使用
# API 模式不加载 CUDA 模型或 Chroma；原本地缓存与索引继续保留。
EMBEDDING_DEVICE=cuda
MODEL_CACHE_DIR=E:/for-LLM/AUXI/Tarot_Persona_Agent/models
CHROMA_DIR=data/indexes/chroma
